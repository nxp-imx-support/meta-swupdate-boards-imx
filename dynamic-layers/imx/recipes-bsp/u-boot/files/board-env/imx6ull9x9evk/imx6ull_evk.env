/*
 * Default U-Boot environment for imx6ull_evk.
 * This file is provided by meta-swupdate-boards-imx because the U-Boot
 * source tree does not include a board env file for this board.
 *
 * Variables defined here are the baseline; they will be overridden by
 * any matching key in files/env/env.txt or files/env/<MACHINE>/env.txt
 * during the do_configure:append() injection step.
 */

bootslot=dualA
swupdate_active=a
swupdate_inactive=b
