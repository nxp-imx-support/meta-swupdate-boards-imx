[Unit]
Description=Clear SWUpdate upgrade status after a successful boot
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if [ "$(fw_printenv -n upgrade_available 2>/dev/null)" = "1" ]; then fw_setenv upgrade_available 0 && fw_setenv bootcount 0; fi'

[Install]
WantedBy=multi-user.target
