rootfs=`swupdate -g`

# Slot A rootfs is mmcblk0p2; running from it means we update Slot B (copy1).
# Running from Slot B (mmcblk0p4) means we update Slot A (copy2).
if [ "$rootfs" = '/dev/mmcblk0p2' ]; then
	selection="-e stable,copy1"
else
	selection="-e stable,copy2"
fi

state=`fw_printenv ustate | cut -f 2 -d'='`
if [ -z "$state" ];then
	fw_setenv ustate 1
	state=`fw_printenv ustate | cut -f 2 -d'='`
fi
if [ "$state" = "1" ];then
	SWUPDATE_SURICATTA_ARGS="-c 2"
else
	# Empty string: swupdate.sh only passes -u when this is non-empty.
	# A single space would trigger suricatta with no args, causing a crash.
	SWUPDATE_SURICATTA_ARGS=""
fi

if [ -e /media/etc/swupdate.cfg ];then
	CFGFILE="/media/etc/swupdate.cfg"
else
	CFGFILE="/etc/swupdate.cfg"
fi

SWUPDATE_ARGS="-H @MACHINE@:1.0 ${selection} -p 'reboot' -f ${CFGFILE}"

# Enable the embedded webserver. swupdate.sh passes -w "$SWUPDATE_WEBSERVER_ARGS"
# only when this variable is non-empty. Port and document_root are taken from
# the webserver{} block in swupdate.cfg; the value here is an extra mongoose
# option string passed verbatim after -w.
SWUPDATE_WEBSERVER_ARGS="port=8080"
